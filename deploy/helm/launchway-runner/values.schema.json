{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Launchway runner chart values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "server",
    "token",
    "runner",
    "deployRunner"
  ],
  "definitions": {
    "quantity": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^[0-9]+(\\.[0-9]+)?([EPTGMk]i?|[mun])?$"
    },
    "probe": {
      "type": [
        "object",
        "null"
      ]
    },
    "envList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ]
      }
    },
    "objectList": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store",
        "key"
      ],
      "properties": {
        "store": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string"
        }
      }
    },
    "imageCredentials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "password"
      ],
      "properties": {
        "username": {
          "type": "string"
        },
        "usernameFrom": {
          "$ref": "#/definitions/secretRef"
        },
        "password": {
          "$ref": "#/definitions/secretRef"
        }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "dataVolume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sizeLimit": {
          "anyOf": [
            {
              "$ref": "#/definitions/quantity"
            },
            {
              "type": "null"
            },
            {
              "const": ""
            }
          ]
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/quantity"
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/quantity"
          }
        }
      }
    }
  },
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "$ref": "#/definitions/stringMap"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "join": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "httpsProxy": {
          "type": "string"
        },
        "httpProxy": {
          "type": "string"
        },
        "noProxy": {
          "type": "string"
        }
      }
    },
    "caBundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configMap": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "kubernetes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
              "maxLength": 63
            },
            "createNamespace": {
              "type": "boolean"
            },
            "namespaceLabels": {
              "$ref": "#/definitions/stringMap"
            },
            "helperImage": {
              "type": "string"
            },
            "serviceAccount": {
              "type": "string"
            },
            "nodeSelector": {
              "$ref": "#/definitions/stringMap"
            },
            "cpu": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "$ref": "#/definitions/quantity"
                }
              ]
            },
            "memory": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "$ref": "#/definitions/quantity"
                }
              ]
            },
            "memoryLimit": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "$ref": "#/definitions/quantity"
                }
              ]
            },
            "maxCpu": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "$ref": "#/definitions/quantity"
                }
              ]
            },
            "maxMemory": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "$ref": "#/definitions/quantity"
                }
              ]
            },
            "imagePullSecrets": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "keepFailed": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))*$"
            },
            "maxPodAge": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))*$"
            },
            "startTimeout": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))*$"
            },
            "restricted": {
              "type": "boolean"
            },
            "runAsUser": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "runAsGroup": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "healthPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "livenessProbe": {
          "$ref": "#/definitions/probe"
        },
        "readinessProbe": {
          "$ref": "#/definitions/probe"
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reports": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxFiles": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "maxFileMiB": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 1024
            },
            "maxTotalMiB": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 1024
            }
          }
        },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "builders": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "address"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
                  },
                  "address": {
                    "type": "string",
                    "pattern": "^(tcp|unix)://.+"
                  },
                  "serverName": {
                    "type": "string"
                  },
                  "platforms": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+/[a-z0-9_]+(/[a-z0-9]+)?$"
                    }
                  },
                  "projects": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            "tlsSecret": {
              "type": "string"
            },
            "registries": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "host"
                ],
                "properties": {
                  "host": {
                    "type": "string",
                    "minLength": 1
                  },
                  "credentials": {
                    "$ref": "#/definitions/imageCredentials"
                  },
                  "pullCredentials": {
                    "$ref": "#/definitions/imageCredentials"
                  },
                  "pullProjects": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "caFile": {
                    "type": "string"
                  },
                  "insecure": {
                    "type": "boolean"
                  },
                  "push": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "projects",
                        "repositories"
                      ],
                      "properties": {
                        "projects": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "repositories": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "signingSecret": {
              "type": "string"
            },
            "scanner": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "image": {
                  "type": "string",
                  "pattern": "^$|@sha256:[0-9a-f]{64}$"
                },
                "dbRepository": {
                  "type": "string"
                },
                "javaDBRepository": {
                  "type": "string"
                }
              }
            },
            "maxContextMiB": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "maxImageMiB": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "secretStores": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "env",
                  "file",
                  "vault"
                ]
              }
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "dataVolume": {
          "$ref": "#/definitions/dataVolume"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "$ref": "#/definitions/objectList"
        },
        "affinity": {
          "type": "object"
        },
        "spreadAcrossNodes": {
          "type": "boolean"
        },
        "topologySpreadConstraints": {
          "$ref": "#/definitions/objectList"
        },
        "priorityClassName": {
          "type": "string"
        },
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        },
        "podLabels": {
          "$ref": "#/definitions/stringMap"
        },
        "extraEnv": {
          "$ref": "#/definitions/envList"
        },
        "extraVolumes": {
          "$ref": "#/definitions/objectList"
        },
        "extraVolumeMounts": {
          "$ref": "#/definitions/objectList"
        },
        "podDisruptionBudget": {
          "$ref": "#/definitions/pdb"
        },
        "serviceAccount": {
          "$ref": "#/definitions/serviceAccount"
        },
        "rbac": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": {
              "type": "boolean"
            }
          }
        },
        "join": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string"
            }
          }
        },
        "labels": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
          }
        },
        "accept": {
          "type": [
            "object",
            "null"
          ]
        },
        "ai": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespace": {
              "type": "string"
            },
            "podLabels": {
              "$ref": "#/definitions/stringMap"
            }
          }
        },
        "server": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "namespaceSelector": {
              "type": "object"
            },
            "podSelector": {
              "type": "object"
            },
            "port": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "kubernetesAPI": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ports": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          }
        },
        "extraEgress": {
          "$ref": "#/definitions/objectList"
        },
        "steps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "egress": {
              "$ref": "#/definitions/objectList"
            }
          }
        }
      }
    },
    "deployRunner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "target": {
          "type": "string"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "argocdNamespace": {
          "type": "string"
        },
        "applications": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "projects",
              "names"
            ],
            "properties": {
              "projects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "names": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                }
              }
            }
          }
        },
        "rolloutNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repos": {
          "type": "object"
        },
        "secretStores": {
          "type": "object"
        },
        "refresh": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "rbac": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": {
              "type": "boolean"
            },
            "patchApplications": {
              "type": "boolean"
            },
            "readDeployments": {
              "type": "boolean"
            },
            "controlRollouts": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                }
              }
            }
          }
        },
        "admissionPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "healthPort": {
          "type": "integer"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "podAnnotations": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array"
        },
        "extraVolumes": {
          "type": "array"
        },
        "extraVolumeMounts": {
          "type": "array"
        },
        "token": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "accept": {
          "type": [
            "object",
            "null"
          ]
        },
        "ai": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "verification": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "url",
              "projects"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
              },
              "type": {
                "enum": [
                  "prometheus",
                  "loki",
                  "clickhouse",
                  "elasticsearch",
                  "opensearch",
                  "postgres",
                  "http"
                ]
              },
              "url": {
                "type": "string",
                "pattern": "^(https?|postgres(ql)?)://.+"
              },
              "projects": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "auth": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "secret"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "bearer",
                      "basic",
                      "header"
                    ]
                  },
                  "user": {
                    "type": "string"
                  },
                  "header": {
                    "type": "string"
                  },
                  "secret": {
                    "$ref": "#/definitions/secretRef"
                  }
                }
              },
              "headers": {
                "$ref": "#/definitions/stringMap"
              },
              "caFile": {
                "type": "string"
              },
              "timeout": {
                "type": "string",
                "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$"
              },
              "limits": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "maxSeries": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1
                  },
                  "maxPoints": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "maxLines": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "maxBytes": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "statements": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[a-z][a-z0-9_]{0,39}$"
                },
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "metric",
                        "logs"
                      ]
                    },
                    "sql": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "method": {
                      "enum": [
                        "GET",
                        "POST"
                      ]
                    },
                    "body": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    },
                    "params": {
                      "$ref": "#/definitions/stringMap"
                    },
                    "projects": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "indices": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "timeField": {
                "type": "string"
              },
              "messageField": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
