{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Launchway chart values",
  "type": "object",
  "definitions": {
    "quantity": {
      "type": ["string", "integer"],
      "pattern": "^[0-9]+(\\.[0-9]+)?([EPTGMk]i?|[mun])?$"
    },
    "probe": { "type": ["object", "null"] },
    "envList": { "type": "array", "items": { "type": "object", "required": ["name"] } },
    "objectList": { "type": "array", "items": { "type": "object" } },
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "secretRef": {
      "type": "object",
      "required": ["store", "key"],
      "properties": {
        "store": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$" },
        "key": { "type": "string", "minLength": 1 },
        "field": { "type": "string" }
      }
    },
    "imageCredentials": {
      "type": "object",
      "required": ["password"],
      "properties": {
        "username": { "type": "string" },
        "usernameFrom": { "$ref": "#/definitions/secretRef" },
        "password": { "$ref": "#/definitions/secretRef" }
      }
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "dataVolume": {
      "type": "object",
      "properties": { "sizeLimit": { "anyOf": [{ "$ref": "#/definitions/quantity" }, { "type": "null" }, { "const": "" }] } }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": { "type": "object", "additionalProperties": { "$ref": "#/definitions/quantity" } },
        "limits": { "type": "object", "additionalProperties": { "$ref": "#/definitions/quantity" } }
      }
    }
  },
  "properties": {
    "strictValues": { "type": "boolean" },
    "externalURL": {
      "type": "string",
      "pattern": "^https?://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]{1,5})?/?$",
      "description": "The address people open, such as https://launchway.example.com: scheme and host, no path."
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "commonLabels": { "$ref": "#/definitions/stringMap" },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "bootstrap": { "enum": ["", "true", "false", true, false] },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "string" } },
    "config": {
      "type": "object",
      "properties": {
        "listen": { "type": "string", "pattern": ":[0-9]{1,5}$" },
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "repo"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "repo": { "type": "string", "minLength": 1 },
              "branch": { "type": "string" },
              "poll": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$" },
              "push": {
                "type": "object",
                "properties": {
                  "branch_prefix": { "type": "string" },
                  "allow_direct": { "type": "array", "items": { "type": "string" } }
                }
              },
              "drafts": {
                "type": "object",
                "properties": {
                  "allow": { "enum": ["admin", "operator", "none"] },
                  "secrets": { "type": "boolean" }
                }
              },
              "pull_requests": {
                "type": "object",
                "properties": {
                  "secrets": { "type": "boolean" }
                }
              }
            }
          }
        },
        "tests": {
          "type": "object",
          "properties": {
            "maxUploadMiB": { "type": ["integer", "null"], "minimum": 1, "maximum": 1024 },
            "maxCasesPerRun": { "type": ["integer", "null"], "minimum": 1 },
            "maxCasesPerProject": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "artifacts": {
          "type": "object",
          "properties": {
            "store": { "type": ["string", "null"], "enum": ["database", "filesystem", "s3", "", null] },
            "database": {
              "type": "object",
              "properties": {
                "maxTotalGiB": { "type": ["integer", "null"], "minimum": 1, "maximum": 1048576 },
                "maxBlobMiB": { "type": ["integer", "null"], "minimum": 1, "maximum": 1048576 }
              }
            },
            "s3": {
              "type": "object",
              "properties": {
                "endpoint": { "type": ["string", "null"], "pattern": "^(https?://[^/]+)?$" },
                "region": { "type": ["string", "null"] },
                "bucket": { "type": ["string", "null"] },
                "prefix": { "type": ["string", "null"] },
                "pathStyle": { "type": ["boolean", "null"] },
                "existingSecret": { "type": ["string", "null"] }
              }
            },
            "maxFileMiB": { "type": ["integer", "null"], "minimum": 1, "maximum": 81920 },
            "maxRunMiB": { "type": ["integer", "null"], "minimum": 1 },
            "maxProjectGiB": { "type": ["integer", "null"], "minimum": 1 },
            "retain": { "type": ["string", "null"], "pattern": "^([0-9]+[dwhm]|[0-9hms.]+)?$" },
            "maxRetain": { "type": ["string", "null"], "pattern": "^([0-9]+[dwhm]|[0-9hms.]+)?$" }
          }
        },
        "findings": {
          "type": "object",
          "properties": {
            "maxUploadMiB": { "type": ["integer", "null"], "minimum": 1, "maximum": 1024 },
            "maxPerRun": { "type": ["integer", "null"], "minimum": 1 },
            "maxPerProject": { "type": ["integer", "null"], "minimum": 1 },
            "maxComponentsPerRun": { "type": ["integer", "null"], "minimum": 1 },
            "maxComponentsPerProject": { "type": ["integer", "null"], "minimum": 1 },
            "maxSbomMiB": { "type": ["integer", "null"], "minimum": 1, "maximum": 1024 }
          }
        },
        "reports": {
          "type": "object",
          "properties": {
            "maxAttachmentFiles": { "type": ["integer", "null"], "minimum": 1, "maximum": 10000 },
            "maxAttachmentMiB": { "type": ["integer", "null"], "minimum": 1, "maximum": 1048576 },
            "maxHtmlFiles": { "type": ["integer", "null"], "minimum": 1, "maximum": 10000 },
            "maxHtmlMiB": { "type": ["integer", "null"], "minimum": 1, "maximum": 1048576 },
            "maxCoverageUploadMiB": { "type": ["integer", "null"], "minimum": 1, "maximum": 1024 },
            "maxCoverageFilesPerRun": { "type": ["integer", "null"], "minimum": 1 },
            "maxCoverageFilesPerProject": { "type": ["integer", "null"], "minimum": 1 },
            "origin": { "type": ["string", "null"], "pattern": "^$|^https?://[^/?#@]+/?$" }
          }
        },
        "loops": {
          "type": "object",
          "properties": { "maxMembers": { "type": ["integer", "null"], "minimum": 1, "maximum": 500 } }
        },
        "schedules": {
          "type": "object",
          "properties": { "enabled": { "type": ["boolean", "null"] } }
        },
        "tokens": {
          "type": "object",
          "properties": { "maxDays": { "type": ["integer", "null"], "minimum": 1, "maximum": 3650 } }
        },
        "policy": {
          "type": ["object", "null"],
          "properties": {
            "waivers": {
              "type": ["object", "null"],
              "properties": {
                "allow": { "type": ["string", "null"], "enum": ["admin", "operator", "none", null] },
                "maxDays": { "type": ["integer", "null"], "minimum": 1, "maximum": 365 }
              }
            },
            "sources": {
              "type": ["array", "null"],
              "items": {
                "type": "object",
                "required": ["name", "library", "version"],
                "properties": {
                  "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
                  "library": { "type": "string" },
                  "version": { "type": "string" },
                  "path": { "type": "string" },
                  "projects": { "type": "array", "items": { "type": "string" } },
                  "refresh": { "type": "string" },
                  "staleAfter": { "type": "string" }
                }
              }
            },
            "policies": { "type": ["array", "null"], "items": { "type": "object" } }
          }
        },
        "mcp": {
          "type": "object",
          "properties": {
            "enabled": { "type": ["boolean", "null"] },
            "allowedOrigins": { "type": ["array", "null"], "items": { "type": "string", "pattern": "^https?://[^/]+/?$" } },
            "requestsPerMinute": { "type": ["integer", "null"], "minimum": 1, "maximum": 100000 },
            "concurrent": { "type": ["integer", "null"], "minimum": 1, "maximum": 100000 },
            "total": { "type": ["integer", "null"], "minimum": 1, "maximum": 100000 },
            "oauth": {
              "type": ["object", "null"],
              "properties": {
                "resource": { "type": ["string", "null"], "pattern": "^(https?://[^/]+/.*mcp)?$" },
                "scopes": { "type": ["array", "null"], "items": { "type": "string" } }
              }
            }
          }
        },
        "queues": {
          "type": ["object", "null"],
          "properties": {
            "maxWait": { "type": ["string", "null"], "pattern": "^(off|([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+)?$" },
            "runs": { "type": ["integer", "null"], "minimum": 0 },
            "pipelineRuns": { "type": ["integer", "null"], "minimum": 0 },
            "pullRequestRuns": { "type": ["integer", "null"], "minimum": 0 },
            "pushRuns": { "type": ["integer", "null"], "minimum": 0 },
            "scheduleRuns": { "type": ["integer", "null"], "minimum": 0 },
            "manualRuns": { "type": ["integer", "null"], "minimum": 0 },
            "automationRuns": { "type": ["integer", "null"], "minimum": 0 },
            "supersedePullRequests": { "type": ["boolean", "null"] }
          }
        },
        "automation": {
          "type": ["object", "null"],
          "properties": { "accounts": { "type": ["array", "null"], "items": { "type": "string", "minLength": 1 } } }
        },
        "pullRequests": {
          "type": ["object", "null"],
          "properties": { "untrusted": { "enum": ["", "restrict", "allow", null] } }
        },
        "notifications": {
          "type": ["object", "null"],
          "properties": {
            "channels": {
              "type": ["array", "null"],
              "items": {
                "type": "object",
                "required": ["name", "kind", "url"],
                "properties": {
                  "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
                  "kind": { "enum": ["webhook", "slack", "discord", "teams"] },
                  "url": { "$ref": "#/definitions/secretRef" },
                  "secret": { "$ref": "#/definitions/secretRef" }
                }
              }
            },
            "rules": {
              "type": ["array", "null"],
              "items": {
                "type": "object",
                "required": ["on", "to"],
                "properties": {
                  "on": { "type": "array", "minItems": 1, "items": { "enum": ["approval.requested", "run.failed", "deployment.succeeded", "deployment.failed", "deployment.rolled_back", "rollback.needs_review", "step.waiting_long"] } },
                  "projects": { "type": "array", "items": { "type": "string" } },
                  "environments": { "type": "array", "items": { "type": "string" } },
                  "branches": { "type": "array", "items": { "type": "string" } },
                  "to": { "type": "array", "minItems": 1, "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "runnerPools": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": { "name": { "type": "string" }, "kind": { "enum": ["build", "deploy"] } }
          }
        },
        "runnerAdmin": { "enum": ["admin", "operator", "none", null] },
        "extraConfig": { "type": "object" }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "url": { "type": "string", "pattern": "^((postgres|postgresql)://.+)?$" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "encryption": {
      "type": "object",
      "properties": {
        "holder": { "enum": ["keyFile", "env", "passphrase", "transit", "none"] },
        "keyFile": {
          "type": "object",
          "properties": {
            "generate": { "type": "boolean" },
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string", "minLength": 1 }
          }
        },
        "env": {
          "type": "object",
          "properties": {
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string", "minLength": 1 }
          }
        },
        "passphrase": {
          "type": "object",
          "properties": {
            "keystoreSecret": { "type": "string" },
            "keystoreSecretKey": { "type": "string", "minLength": 1 },
            "passphraseSecret": { "type": "string" },
            "passphraseSecretKey": { "type": "string", "minLength": 1 }
          }
        },
        "transit": {
          "type": "object",
          "properties": {
            "address": { "type": "string", "pattern": "^(https?://.+)?$" },
            "mount": { "type": "string" },
            "key": { "type": "string" },
            "namespace": { "type": "string" },
            "tokenSecret": { "type": "string" },
            "tokenSecretKey": { "type": "string", "minLength": 1 },
            "role": { "type": "string" },
            "authPath": { "type": "string" },
            "caSecret": { "type": "string" }
          }
        },
        "previousKey": {
          "type": "object",
          "properties": {
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "runnerToken": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "strategy": {
          "type": "object",
          "properties": {
            "rollingUpdate": {
              "type": "object",
              "properties": {
                "maxUnavailable": { "type": ["integer", "string"] },
                "maxSurge": { "type": ["integer", "string"] }
              }
            }
          }
        },
        "preStopSleepSeconds": { "type": "integer", "minimum": 0 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "resources": { "$ref": "#/definitions/resources" },
        "dataVolume": { "$ref": "#/definitions/dataVolume" },
        "startupProbe": { "$ref": "#/definitions/probe" },
        "livenessProbe": { "$ref": "#/definitions/probe" },
        "readinessProbe": { "$ref": "#/definitions/probe" },
        "spreadAcrossNodes": { "type": "boolean" },
        "topologySpreadConstraints": { "$ref": "#/definitions/objectList" },
        "affinity": { "type": "object" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "$ref": "#/definitions/objectList" },
        "priorityClassName": { "type": "string" },
        "podAnnotations": { "$ref": "#/definitions/stringMap" },
        "podLabels": { "$ref": "#/definitions/stringMap" },
        "extraEnv": { "$ref": "#/definitions/envList" },
        "extraVolumes": { "$ref": "#/definitions/objectList" },
        "extraVolumeMounts": { "$ref": "#/definitions/objectList" },
        "podDisruptionBudget": { "$ref": "#/definitions/pdb" },
        "serviceAccount": { "$ref": "#/definitions/serviceAccount" }
      }
    },
    "ssh": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "service": {
          "type": "object",
          "properties": {
            "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "annotations": { "$ref": "#/definitions/stringMap" }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "hosts": { "type": "array", "items": { "type": "string" } },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretName": { "type": "string" },
              "hosts": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "parentRefs": { "type": "array", "items": { "type": "object", "required": ["name"] } },
        "hostnames": { "type": "array", "items": { "type": "string" } }
      }
    },
    "runner": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 0 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "serverURL": { "type": "string", "pattern": "^(https?://.+)?$" },
        "join": {
          "type": ["object", "null"],
          "properties": { "existingSecret": { "type": "string" }, "existingSecretKey": { "type": "string" } }
        },
        "labels": { "type": ["array", "null"], "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$" } },
        "accept": { "type": ["object", "null"] },
        "kubernetes": {
          "type": "object",
          "properties": {
            "namespace": { "type": "string", "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$", "maxLength": 63 },
            "createNamespace": { "type": "boolean" },
            "namespaceLabels": { "$ref": "#/definitions/stringMap" },
            "helperImage": { "type": "string" },
            "priorityClassName": { "type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$" },
            "serviceAccount": { "type": "string" },
            "nodeSelector": { "$ref": "#/definitions/stringMap" },
            "cpu": { "anyOf": [{ "const": "" }, { "$ref": "#/definitions/quantity" }] },
            "memory": { "anyOf": [{ "const": "" }, { "$ref": "#/definitions/quantity" }] },
            "memoryLimit": { "anyOf": [{ "const": "" }, { "$ref": "#/definitions/quantity" }] },
            "maxCpu": { "anyOf": [{ "const": "" }, { "$ref": "#/definitions/quantity" }] },
            "maxMemory": { "anyOf": [{ "const": "" }, { "$ref": "#/definitions/quantity" }] },
            "imagePullSecrets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "pod": { "enum": ["", "per-step", "per-run"] },
            "maxWorkspace": { "anyOf": [{ "const": "" }, { "$ref": "#/definitions/quantity" }] },
            "maxWorkspaces": { "anyOf": [{ "const": "" }, { "$ref": "#/definitions/quantity" }] },
            "keepFailed": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))*$" },
            "maxPodAge": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))*$" },
            "startTimeout": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))*$" },
            "restricted": { "type": "boolean" },
            "runAsUser": { "type": ["integer", "null"], "minimum": 1 },
            "runAsGroup": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "healthPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "livenessProbe": { "$ref": "#/definitions/probe" },
        "readinessProbe": { "$ref": "#/definitions/probe" },
        "extraArgs": { "type": "array", "items": { "type": "string" } },
        "reports": {
          "type": "object",
          "properties": {
            "maxFiles": { "type": ["integer", "null"], "minimum": 1 },
            "maxFileMiB": { "type": ["integer", "null"], "minimum": 1, "maximum": 1024 },
            "maxTotalMiB": { "type": ["integer", "null"], "minimum": 1, "maximum": 1024 }
          }
        },
        "images": {
          "type": "object",
          "properties": {
            "builders": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "address"],
                "properties": {
                  "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
                  "address": { "type": "string", "pattern": "^(tcp|unix)://.+" },
                  "serverName": { "type": "string" },
                  "platforms": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+/[a-z0-9_]+(/[a-z0-9]+)?$" } },
                  "projects": { "type": "array", "items": { "type": "string", "minLength": 1 } }
                }
              }
            },
            "tlsSecret": { "type": "string" },
            "registries": {
              "type": "object",
              "propertyNames": { "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
              "additionalProperties": {
                "type": "object",
                "required": ["host"],
                "properties": {
                  "host": { "type": "string", "minLength": 1 },
                  "credentials": { "$ref": "#/definitions/imageCredentials" },
                  "pullCredentials": { "$ref": "#/definitions/imageCredentials" },
                  "pullProjects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "caFile": { "type": "string" },
                  "insecure": { "type": "boolean" },
                  "push": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["projects", "repositories"],
                      "properties": {
                        "projects": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                        "repositories": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
                      }
                    }
                  }
                }
              }
            },
            "signingSecret": { "type": "string" },
            "scanner": {
              "type": "object",
              "properties": {
                "image": { "type": "string", "pattern": "^$|@sha256:[0-9a-f]{64}$" },
                "dbRepository": { "type": "string" },
                "javaDBRepository": { "type": "string" }
              }
            },
            "maxContextMiB": { "type": ["integer", "null"], "minimum": 1 },
            "maxImageMiB": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "ai": { "type": ["boolean", "null"] },
        "secretStores": {
          "type": "object",
          "additionalProperties": {
