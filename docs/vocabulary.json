{
  "comment": "The glossary of record as data. docs/reference/vocabulary.md is the page people read; this file is what the tools read: scripts/vocabulary-fix (the check and the fixer) and `make vocabulary`. Edit this file, then run `scripts/vocabulary-fix --docs` to rewrite the page's tables. Not legal advice: the safety notes live in the private research file.",
  "version": 1,
  "rules": {
    "people-read": "What a person reads (screens, documentation, command help and output, the `error` and `next` sentences, MCP descriptions, notices, chart comments) uses the product words. Screens and messages the server builds ask the terms system ({key}, terms().label) so a rename takes effect; documentation names the default word and, once per page that introduces a level, the plain word beside it. Never a hard-coded plain level name where the level is meant.",
    "identifiers": "Stable identifiers (API JSON fields and paths, database tables and columns, configuration keys and kind names, command-line flags, metric names, event kinds, Go identifiers) cannot follow a renameable word. Each level has one neutral, permanent name: installation, organization, unit, project. They are documented as 'the API name of a Base' and are never themed.",
    "ordinary-words": "Where an industry word is the accepted term it stays ordinary: pipeline, step, alert, branch, pull request, commit, secret, variable, template, library. Everything else Launchway names itself (runner, run, queue, deploy, environment, rollback, canary, registry, artifact and the rest of the table) uses the product word, with the plain word beside it where the word is introduced.",
    "buttons": "A button for a delivery action uses the product verb: Launch (deploy), Return to base (rollback), Abort (emergency rollback). The plain word is in the button's accessible description and in the confirmation text. Elsewhere an ordinary verb on a button stays acceptable where a newcomer must understand it (Save, Cancel, Approve, Reject).",
    "capitals": "Product words are capitalized as names, in pages as well as documents: Sortie, Station, Airfield, Launch, Tower, Radar. Level words (Base, Wing, Squadron, Project) and feature words (Wingman, Preflight, Clearance, Logbook, Flight plan, Detachment, Payload) too. The business set reads as ordinary English: its words are lower case in the middle of a sentence, except the level words. 'launch line' stays lower case.",
    "spelling": "American English: organization, color, behavior, license (noun and verb), initialize, customize.",
    "disclaimer": "These are ordinary words used descriptively. Launchway is not affiliated with or endorsed by any military service.",
    "levels-in-prose": "Where a level is meant, prose uses the default word (Base, Wing, Squadron, Project), never the plain word: 'organization' for the second level, 'unit' or 'team' for the third, 'installation' for the top level. The plain word appears once where the vocabulary is introduced, on the vocabulary page, and in code font where a literal identifier is shown (`organization`, `--organization`, JSON fields). 'Installation' stays the ordinary word for a running Launchway deployment. 'organization' stays where it means the real-world company ('your organization's identity provider'); those uses are on the allow-list.",
    "statuses": "A status is always shown with an icon and its plain word beside the themed one ('Airborne · running'); in the business set only the plain word. Never color alone.",
    "no-combat": "Flying and ground operations only. No strike, target, kill, weapon or attack words and no real program, unit or rank names are product words.",
    "stable-addresses": "Page addresses (URLs, routes), documentation file names, anchors, flags, API fields and enum values, JSON output, and stored role names never change with a word."
  },
  "stableNames": {
    "today": [
      {
        "layer": "config kind, overview JSON, CLI `config`",
        "name": "installation, organisation, unit, project",
        "note": "second level is British here"
      },
      {
        "layer": "variables API, CLI flags, MCP schemas",
        "name": "installation, organization, unit, project",
        "note": "American; organisation accepted as an alias"
      },
      {
        "layer": "terms keys, web code",
        "name": "installation, organization, unit, project",
        "note": "American"
      },
      {
        "layer": "Go types",
        "name": "settings.Organisation, settings.LevelOrganization",
        "note": "both spellings"
      }
    ],
    "recommendation": "Keep installation, organization, unit, project as the permanent API names. Make organization (American) canonical in the configuration kind, the overview JSON and the Go types with organisation accepted as a documented read alias for at least two releases. Do not number the levels and do not use the aviation words as identifiers."
  },
  "scan": {
    "docs": [
      "README.md",
      "CONTRIBUTING.md",
      "SECURITY.md",
      "SUPPORT.md",
      "docs/**/*.md",
      "internal/pipeline/guide/*.md",
      "deploy/README.md"
    ],
    "web": [
      "web/src/**/*.ts",
      "web/src/**/*.tsx"
    ],
    "go": [
      "cmd/launchway/*.go",
      "internal/api/*.go",
      "internal/settings/*.go",
      "internal/config/*.go"
    ],
    "helm": [
      "deploy/helm/**/values.yaml",
      "deploy/helm/**/NOTES.txt"
    ],
    "json": [
      "docs/roadmap/roadmap.json"
    ],
    "skipPaths": [
      "node_modules/",
      "/dist/",
      "docs/.vitepress/",
      "docs/public/",
      ".test.",
      "_test.go",
      "web/src/test/",
      "/testdata/",
      "docs/vocabulary.json"
    ],
    "generated": [
      "docs/reference/interface-parity.md",
      "docs/reference/helm-values.md",
      "docs/roadmap-list.md",
      "docs/roadmap/milestone-*.md",
      "docs/roadmap/beyond.md",
      "docs/reference/accessibility-conformance.md"
    ],
    "webDataModules": [
      "web/src/shell/guideData.ts",
      "web/src/shell/comingData.ts",
      "web/src/learn/links.ts"
    ],
    "webDataModulesNote": "Modules of constant text whose accessors fill the words in (guideFor, comingFor, the Learn links): scripts/vocabulary-fix --web writes placeholders into their strings without wrapping them."
  },
  "checks": [
    {
      "id": "british-spelling",
      "severity": "error",
      "pattern": "\\b(organisation\\w*|colour\\w*|behaviour\\w*|favour\\w*|licence[sd]?|initialis\\w+|authoris\\w+|customis\\w+|summaris\\w+|recognis\\w+|normalis\\w+|synchronis\\w+|catalogue[sd]?|centre[sd]?|defence|artefacts?)\\b",
      "britishOnly": false,
      "use": "the American spelling (organization, color, behavior, license, initialize, customize ...)",
      "fix": "american"
    },
    {
      "id": "org-shorthand",
      "severity": "error",
      "pattern": "(?<![./@\\w-])orgs?(?![./\\w-])",
      "use": "the level word through the terms system ({organization}), or write the plain word",
      "fix": null
    },
    {
      "id": "tenant",
      "severity": "error",
      "pattern": "(?<!multi-)(?<!multi)\\btenants?\\b",
      "use": "the top level word ({installation}: Base) or 'customer'",
      "fix": null
    },
    {
      "id": "audit-log",
      "severity": "error",
      "pattern": "\\baudit logs?\\b",
      "use": "the Logbook ({logbook}) or, in plain description, the audit trail",
      "fix": "audit-trail"
    },
    {
      "id": "detachment-synonym",
      "severity": "error",
      "pattern": "\\bdelegates?\\b|\\b(?:customer|remote|on-prem\\w*)[- ](?:side )?(?:agent|connector)s?\\b",
      "use": "Detachment",
      "fix": null
    },
    {
      "id": "wingman-synonym",
      "severity": "error",
      "pattern": "\\b(?:copilot|co-pilot|chat-?bot)s?\\b",
      "use": "the guide ({guide}: Wingman)",
      "fix": null
    },
    {
      "id": "assistant-in-screens",
      "severity": "error",
      "scope": [
        "web",
        "go"
      ],
      "pattern": "(?<!AI )\\bassistants?\\b",
      "use": "the guide ({guide}: Wingman); 'assistant' stays only for a third-party AI assistant that connects through MCP",
      "fix": null
    },
    {
      "id": "hardcoded-product-word",
      "severity": "error",
      "scope": [
        "web"
      ],
      "pattern": "(?<![{_])\\b(?:Wingmen|Wingman|Squadrons?|Preflight|Clearances?|Logbook|Flight plans?|Payloads?|No-go)\\b(?!\\})",
      "caseSensitive": true,
      "use": "the terms system: {guide}, {unit}, {preflight}, {clearance}, {logbook}, {flight_plan}, {payload}, {no_go}",
      "fix": null
    },
    {
      "id": "hardcoded-level-word",
      "severity": "review",
      "scope": [
        "web"
      ],
      "pattern": "(?<!\\{)\\b(?:organi[sz]ations?|installations?)\\b(?!\\})",
      "use": "the terms system when the level is meant ({organization}, {installation}); ordinary use (an organization's identity provider; installing software) may stay and goes on the allow list",
      "fix": null
    },
    {
      "id": "approval-for-clearance",
      "severity": "review",
      "scope": [
        "web",
        "docs"
      ],
      "pattern": "\\b(?:deploy|deployment|run|step)[- ]approvals?\\b|\\bapprovals? (?:step|gate)\\b",
      "use": "clearance for the thing a person gives; approval stays for pull-request reviews and the step key",
      "fix": null
    },
    {
      "id": "template-ambiguity",
      "severity": "review",
      "scope": [
        "docs",
        "web"
      ],
      "pattern": "\\bpipeline templates?\\b",
      "use": "flight plan (a whole ready-made pipeline) or step template (a reusable part)",
      "fix": null
    },
    {
      "id": "level-organization",
      "severity": "error",
      "scope": [
        "docs",
        "json"
      ],
      "pattern": "(?<!your )(?<!their )\\borgani[sz]ations?\\b",
      "use": "Wing (the second level) or, for the real-world company, add the use to the allow-list",
      "fix": "wing"
    },
    {
      "id": "level-unit",
      "severity": "error",
      "scope": [
        "docs",
        "json"
      ],
      "pattern": "(?<![\\w`-])(?:(?:a|an|the|its|their|that|this|another|each|every|per|one|any|no|other|own|whole|separate|hosted|customer's|operator's|operator’s|customer’s|or|of|at|in|and)|\\(a|\\(the) units?\\b(?! (?:of work|test|tests|file|below|runs the|as a service|applies)|[-\\w])|\\bUnits?\\b(?=\\.\\*\\*)",
      "use": "Squadron (the third level)",
      "fix": "squadron"
    },
    {
      "id": "level-installation",
      "severity": "error",
      "scope": [
        "docs",
        "json"
      ],
      "pattern": "\\binstallation (?:settings?|level|defaults?)\\b|\\binstallation, (?:the )?organi[sz]ation\\b|\\bthe installation and the organi[sz]ation\\b",
      "use": "Base (the top level); 'installation' stays for a running deployment",
      "fix": "base"
    },
    {
      "id": "level-lowercase",
      "severity": "error",
      "scope": [
        "docs",
        "json"
      ],
      "caseSensitive": true,
      "pattern": "(?<=[a-z,] )(?:the|a|an|your|its|each|every|own|whole|that|this|one|another|between|into|of|operator's|customer's|hosted|separate|other) (?:wings?|squadrons?)\\b|\\b(?:the|your|its|each|every|own|whole|that|this|one|another|between|into|of|operator's|customer's|hosted|separate|other) base(?:s)?\\b(?! (?:image|images|branch|URL|directory|path|name|class|case|layer|domain|address|[0-9]|and))",
      "use": "Base, Wing and Squadron are proper names: capitalize them",
      "fix": "capitalize-level"
    },
    {
      "id": "feature-lowercase",
      "severity": "error",
      "scope": [
        "docs",
        "json"
      ],
      "caseSensitive": true,
      "pattern": "(?<=[a-z,;] )(?:wingmen|wingman|logbook|detachments?|flight plans?)\\b",
      "use": "capitalize the product noun (Wingman, Logbook, Detachment, Flight plan)",
      "fix": "capitalize-feature"
    },
    {
      "id": "launch-line-capital",
      "severity": "error",
      "scope": [
        "docs",
        "json"
      ],
      "caseSensitive": true,
      "pattern": "(?<=[a-z,;] )Launch line\\b",
      "use": "launch line stays lower case",
      "fix": "lowercase"
    },
    {
      "id": "the-audit-trail",
      "severity": "error",
      "scope": [
        "docs",
        "json"
      ],
      "pattern": "\\bthe audit trail\\b",
      "use": "the Logbook",
      "fix": "logbook"
    },
    {
      "id": "team-as-level",
      "severity": "review",
      "scope": [
        "docs",
        "json"
      ],
      "pattern": "\\b(?:optional|the|each|per|another) teams?\\b",
      "use": "Squadron when the third level is meant",
      "fix": null
    },
    {
      "id": "installation-as-level",
      "severity": "review",
      "scope": [
        "docs",
        "json"
      ],
      "pattern": "\\bwhole installation\\b|\\binstallation\\b(?= (?:is|has|chooses|calls))",
      "use": "Base when the top level is meant",
      "fix": null
    },
    {
      "id": "clearance-preflight-lowercase",
      "severity": "review",
      "scope": [
        "docs",
        "json"
      ],
      "caseSensitive": true,
      "pattern": "(?<=[a-z,;] )(?:clearances?|preflight|payloads?)\\b",
      "use": "capitalize when the product concept is meant (webhook payloads and CORS preflight are ordinary)",
      "fix": null
    }
  ],
