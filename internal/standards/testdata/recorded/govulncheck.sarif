            {
              "id": "GO-2026-5942",
              "shortDescription": {
                "text": "[GO-2026-5942] Parsing an invalid SVCB or HTTPS RR can panic in golang.org/x/net/dns/dnsmessage"
              },
              "fullDescription": {
                "text": "Parsing an invalid SVCB or HTTPS RR can panic in golang.org/x/net/dns/dnsmessage"
              },
              "help": {
                "text": "Parsing an invalid SVCB or HTTPS RR can panic when the size of a parameter value overflows the message buffer."
              },
              "helpUri": "https://pkg.go.dev/vuln/GO-2026-5942",
              "properties": {
                "tags": [
