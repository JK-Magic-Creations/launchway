  "runs": [
    {
      "tool": {
        "driver": {
          "name": "govulncheck",
          "semanticVersion": "v1.9.0",
          "informationUri": "https://pkg.go.dev/golang.org/x/vuln/cmd/govulncheck",
          "properties": {
            "protocol_version": "v1.0.0",
            "scanner_name": "govulncheck",
            "scanner_version": "v1.9.0",
            "db": "https://vuln.go.dev",
            "db_last_modified": "2026-11-11T02:51:11Z",
            "go_version": "go1.27.4",
            "scan_level": "symbol",
            "scan_mode": "source"
          },
          "rules": [
            {
              "id": "GO-2026-5970",
              "shortDescription": {
                "text": "[GO-2026-5970] Infinite loop on invalid input in golang.org/x/text"
              },
              "fullDescription": {
                "text": "Infinite loop on invalid input in golang.org/x/text"
              },
              "help": {
                "text": "A norm.Iter can enter an infinite loop when handling input containing invalid UTF-8 bytes."
              },
              "helpUri": "https://pkg.go.dev/vuln/GO-2026-5970",
              "properties": {
                "tags": [
                  "CVE-2026-56852"
                ]
              }
            },
            {
              "id": "GO-2026-6629",
              "shortDescription": {
                "text": "[GO-2026-6629] Panic parsing crafted input in x/text/secure/precis in golang.org/x/text"
              },
              "fullDescription": {
                "text": "Panic parsing crafted input in x/text/secure/precis in golang.org/x/text"
              },
              "help": {
                "text": "The Nickname profile can panic with an out-of-bounds slice error when transforming crafted input into a short destination buffer."
              },
              "helpUri": "https://pkg.go.dev/vuln/GO-2026-6629",
              "properties": {
                "tags": [
                  "CVE-2026-56851"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "GO-2026-5970",
          "level": "note",
          "message": {
