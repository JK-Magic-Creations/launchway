{"$schema":"http://json.schemastore.org/sarif-2.1.0","runs":[{"defaultSourceLanguage":"dockerfile","results":[{"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"Dockerfile"},"region":{"endColumn":1,"endLine":1,"sourceLanguage":"dockerfile","startColumn":1,"startLine":1}}}],"message":{"text":"Using latest is prone to errors if the image will ever update. Pin the version explicitly to a release tag"},"ruleId":"DL3007"},{"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"uri":"Dockerfile"},"region":{"endColumn":1,"endLine":2,"sourceLanguage":"dockerfile","startColumn":1,"startLine":2}}}],"message":{"text":"Delete the apt lists (/var/lib/apt/lists) after installing something"},"ruleId":"DL3009"},{"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"Dockerfile"},"region":{"endColumn":1,"endLine":2,"sourceLanguage":"dockerfile","startColumn":1,"startLine":2}}}],"message":{"text":"Pin versions in apt get install. Instead of `apt-get install <package>` use `apt-get install <package>=<version>`"},"ruleId":"DL3008"},{"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"uri":"Dockerfile"},"region":{"endColumn":1,"endLine":2,"sourceLanguage":"dockerfile","startColumn":1,"startLine":2}}}],"message":{"text":"Avoid additional packages by specifying `--no-install-recommends`"},"ruleId":"DL3015"},{"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"Dockerfile"},"region":{"endColumn":1,"endLine":4,"sourceLanguage":"dockerfile","startColumn":1,"startLine":4}}}],"message":{"text":"Do not use sudo as it leads to unpredictable behavior. Use a tool like gosu to enforce root"},"ruleId":"DL3004"},{"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"Dockerfile"},"region":{"endColumn":1,"endLine":5,"sourceLanguage":"dockerfile","startColumn":1,"startLine":5}}}],"message":{"text":"Last USER should not be root"},"ruleId":"DL3002"},{"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"uri":"Dockerfile"},"region":{"endColumn":1,"endLine":5,"sourceLanguage":"dockerfile","startColumn":1,"startLine":5}}}],"message":{"text":"Non-numeric user-id may not be resolvable by host system"},"ruleId":"DL3066"}],"tool":{"driver":{"downloadUri":"https://github.com/hadolint/hadolint","fullName":"Haskell Dockerfile Linter","name":"Hadolint","shortDescription":{"text":"Dockerfile linter, validate inline bash, written in Haskell"},"version":"2.15.1"}}}],"version":"2.1.0"}